# Vercel: public configuration only. Do not place backend secrets here.
NEXT_PUBLIC_SITE_URL=https://www.chloepratas.com
NEXT_PUBLIC_API_URL=https://api.chloepratas.com
NEXT_PUBLIC_AUTH_URL=https://auth.chloepratas.com
# Set true for ordinary vercel.app previews; use a stable custom staging domain for auth.
NEXT_PUBLIC_READ_ONLY=false
