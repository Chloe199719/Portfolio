{
  "name": "chloe-personal-home",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:backup": "bash scripts/backup.sh",
    "content:restore": "bash scripts/restore.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "openapi-typescript backend/openapi.json -o lib/generated/api.d.ts",
    "backend:test": "cd backend && go test -race ./...",
    "backend:dev": "cd backend && go run ./cmd/server"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@portabletext/editor": "^8.2.3",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@radix-ui/react-icons": "^1.3.2",
    "next": "^16.4.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
